{
  "name": "@isavail/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "ready": "vp check && vp run -r test",
    "dev": "vp run @isavail/isavail#dev",
    "build": "vp run @isavail/isavail#build",
    "start": "vp run @isavail/isavail#start",
    "generate:openapi": "vp run @isavail/isavail#generate:openapi"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@isavail/oxlint-plugin": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
