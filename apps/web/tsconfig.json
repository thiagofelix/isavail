{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "barrelImportPackages": ["effect"],
        "allowedUnstableApis": [
          "@effect/platform-browser/BrowserCrypto",
          "effect/Crypto",
          "@isavail/availability-contract/relay-http-api",
          "@effect/vitest",
          "effect/http-api/HttpApi",
          "effect/http-api/HttpApiBuilder",
          "effect/http-api/HttpApiClient",
          "effect/http-api/HttpApiEndpoint",
          "effect/http-api/HttpApiGroup",
          "effect/http-api/HttpApiMiddleware",
          "effect/http-api/HttpApiTest",
          "effect/http-api/OpenApi",
          "effect/http/FetchHttpClient",
          "effect/http/HttpClient",
          "effect/http/HttpClientRequest",
          "effect/http/HttpRouter",
          "effect/http/HttpServer"
        ],
        "overrides": [
          {
            "include": ["scripts/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "@effect/platform-node/NodeRuntime",
                "@effect/platform-node/NodeServices",
                "effect/FileSystem",
                "effect/Path",
                "effect/http-api/OpenApi"
              ]
            }
          }
        ]
      }
    ]
  },
  "include": ["src", "test", "scripts", "alchemy.run.ts", "vite.config.ts"]
}
