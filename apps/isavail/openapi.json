{
  "openapi": "3.1.0",
  "info": {
    "title": "isavail — .br domain availability",
    "version": "0.0.1",
    "description": "Checks whether .br domains can be registered, using Registro.br's official ISAVAIL availability service. Designed for people and AI agents generating company names: send bare names or full domains, and read each check's availability._tag. Available and AvailableWithCompetingTickets can be registered now; ReleaseInProgress and CompetitiveReleaseInProgress accept tickets inside their window; Registered, Unavailable, and AwaitingRelease cannot be registered now."
  },
  "paths": {
    "/v1/availability-checks": {
      "post": {
        "tags": [
          "domainAvailability"
        ],
        "operationId": "domainAvailability.checkDomains",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "DomainCheckReport",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainCheckReport"
                }
              }
            }
          },
          "400": {
            "description": "InvalidDomainNames",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidDomainNamesEncoded"
                }
              }
            }
          }
        },
        "description": "Checks up to 50 domains or bare company names at Registro.br. Entries that normalize to the same domain are checked once. Registro.br answers a burst of about 30 questions and then about one per second, so in a large batch some checks can be NotChecked with a RegistryRateLimited failure; send those domains again after retryAfterSeconds.",
        "summary": "Check several .br domains",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DomainCheckRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v1/domains/{domain}/availability": {
      "get": {
        "tags": [
          "domainAvailability"
        ],
        "operationId": "domainAvailability.checkDomain",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "schema": {
              "type": "string",
              "description": "A .br domain such as minhaempresa.com.br, or a bare company name.",
              "examples": [
                "minhaempresa.com.br"
              ]
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "DomainCheckReport",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainCheckReport"
                }
              }
            }
          },
          "400": {
            "description": "InvalidDomainNames",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidDomainNamesEncoded"
                }
              }
            }
          }
        },
        "description": "Checks one domain or bare company name at Registro.br and returns a report with a single check.",
        "summary": "Check one .br domain"
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "system.checkHealth",
        "parameters": [],
        "security": [],
        "responses": {
          "204": {
            "description": "<No Content>"
          }
        },
        "description": "Answers 204 while the service accepts requests. It does not ask Registro.br, so it spends none of the query budget.",
        "summary": "Check that the service is running"
      }
    }
  },
  "components": {
    "schemas": {
      "InvalidDomainNamesEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "InvalidDomainNames"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "InvalidDomainNames"
            ]
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Identifies this response. Quote it when asking for support.",
            "examples": [
              "req_6f1c2a7e-3b9d-4c2e-9a51-0d4b8e7f2c13"
            ]
          },
          "retryable": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "details": {
            "type": "object",
            "properties": {
              "violations": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DomainNameViolation"
                }
              }
            },
            "required": [
              "violations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "_tag",
          "code",
          "message",
          "requestId",
          "retryable",
          "details"
        ],
        "additionalProperties": false
      },
      "DomainNameViolation": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "The entry exactly as it was sent."
          },
          "message": {
            "type": "string",
            "description": "What is wrong with the entry."
          }
        },
        "required": [
          "input",
          "message"
        ],
        "additionalProperties": false
      },
      "DomainCheckReport": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Identifies this response. Quote it when asking for support.",
            "examples": [
              "req_6f1c2a7e-3b9d-4c2e-9a51-0d4b8e7f2c13"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DomainCheck"
            }
          }
        },
        "required": [
          "requestId",
          "checks"
        ],
        "additionalProperties": false
      },
      "DomainCheck": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "Checked"
                ]
              },
              "domainName": {
                "type": "string",
                "maxLength": 253,
                "description": "A lowercase, fully qualified domain name under .br, in its Unicode form.",
                "examples": [
                  "minhaempresa.com.br"
                ]
              },
              "availability": {
                "$ref": "#/components/schemas/DomainAvailability"
              },
              "checkedAt": {
                "type": "string"
              },
              "servedFromCache": {
                "type": "boolean",
                "description": "True when this answer was reused from a recent check instead of asking Registro.br again."
              }
            },
            "required": [
              "_tag",
              "domainName",
              "availability",
              "checkedAt",
              "servedFromCache"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "NotChecked"
                ]
              },
              "domainName": {
                "type": "string",
                "maxLength": 253,
                "description": "A lowercase, fully qualified domain name under .br, in its Unicode form.",
                "examples": [
                  "minhaempresa.com.br"
                ]
              },
              "failure": {
                "$ref": "#/components/schemas/DomainCheckFailure"
              }
            },
            "required": [
              "_tag",
              "domainName",
              "failure"
            ],
            "additionalProperties": false
          }
        ]
      },
      "DomainCheckFailure": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "RegistryRateLimited"
                ]
              },
              "retryAfterSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Whole seconds to wait before retrying.",
                "examples": [
                  30
                ]
              }
            },
            "required": [
              "_tag",
              "retryAfterSeconds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "RegistryUnreachable"
                ]
              }
            },
            "required": [
              "_tag"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "RegistryResponseUnreadable"
                ]
              }
            },
            "required": [
              "_tag"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "RegistryFailed"
                ]
              },
              "registryMessage": {
                "type": "string"
              }
            },
            "required": [
              "_tag",
              "registryMessage"
            ],
            "additionalProperties": false
          }
        ]
      },
      "DomainAvailability": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "Available"
                ]
              }
            },
            "required": [
              "_tag"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "AvailableWithCompetingTickets"
                ]
              },
              "competingTicketCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Registration tickets other people have already opened for this domain.",
                "examples": [
                  2
                ]
              }
            },
            "required": [
              "_tag",
              "competingTicketCount"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "Registered"
                ]
              },
              "expiry": {
                "$ref": "#/components/schemas/RegistrationExpiry"
              },
              "publicationStatus": {
                "type": "string",
                "description": "Registro.br DNS publication status, such as published or on-hold."
              },
              "nameservers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "suggestedAlternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 253,
                  "description": "A lowercase, fully qualified domain name under .br, in its Unicode form.",
                  "examples": [
                    "minhaempresa.com.br"
                  ]
                },
                "description": "The same name under other Registro.br categories that Registro.br suggests instead, such as minhaempresa.net.br."
              }
            },
            "required": [
              "_tag",
              "expiry",
              "publicationStatus",
              "nameservers",
              "suggestedAlternatives"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "Unavailable"
                ]
              },
              "reason": {
                "$ref": "#/components/schemas/UnavailableReason"
              },
              "registryMessage": {
                "type": "string",
                "description": "The reason exactly as Registro.br worded it."
              },
              "suggestedAlternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 253,
                  "description": "A lowercase, fully qualified domain name under .br, in its Unicode form.",
                  "examples": [
                    "minhaempresa.com.br"
                  ]
                },
                "description": "The same name under other Registro.br categories that Registro.br suggests instead, such as minhaempresa.net.br."
              }
            },
            "required": [
              "_tag",
              "reason",
              "registryMessage",
              "suggestedAlternatives"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "AwaitingRelease"
                ]
              }
            },
            "required": [
              "_tag"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "ReleaseInProgress"
                ]
              },
              "window": {
                "$ref": "#/components/schemas/ReleaseWindow"
              },
              "competingTicketCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Registration tickets other people have already opened for this domain.",
                "examples": [
                  2
                ]
              }
            },
            "required": [
              "_tag",
              "window",
              "competingTicketCount"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "CompetitiveReleaseInProgress"
                ]
              },
              "window": {
                "$ref": "#/components/schemas/ReleaseWindow"
              },
              "acceptingTicketsUntil": {
                "type": "string"
              },
              "competingTicketCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Registration tickets other people have already opened for this domain.",
                "examples": [
                  2
                ]
              }
            },
            "required": [
              "_tag",
              "window",
              "acceptingTicketsUntil",
              "competingTicketCount"
            ],
            "additionalProperties": false
          }
        ]
      },
      "ReleaseWindow": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          }
        },
        "required": [
          "startsAt",
          "endsAt"
        ],
        "additionalProperties": false
      },
      "UnavailableReason": {
        "type": "string",
        "enum": [
          "Reserved",
          "InvalidDomain",
          "InvalidCategory",
          "Other"
        ]
      },
      "RegistrationExpiry": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "ExemptFromPayment"
                ]
              }
            },
            "required": [
              "_tag"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "ExpiresOn"
                ]
              },
              "date": {
                "type": "string",
                "description": "A calendar date in YYYY-MM-DD form.",
                "examples": [
                  "2027-05-18"
                ]
              }
            },
            "required": [
              "_tag",
              "date"
            ],
            "additionalProperties": false
          }
        ]
      },
      "DomainCheckRequest": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A .br domain such as minhaempresa.com.br, or a bare name such as minhaempresa, which is checked as minhaempresa.com.br."
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "domains"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "domains": [
              "minhaempresa",
              "minhaempresa.net.br",
              "minha-empresa.com.br"
            ]
          }
        ]
      }
    },
    "securitySchemes": {}
  },
  "security": [],
  "tags": [
    {
      "name": "domainAvailability"
    },
    {
      "name": "system"
    }
  ]
}
